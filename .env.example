# The Plug — sekrety lokalne.
# 1. Skopiuj ten plik jako  .env  (bez .example) w tym samym folderze.
# 2. Wklej swoj token z Apify po znaku = (bez cudzyslowow, bez spacji).
# 3. Zapisz. Skrypt sam go wczyta. NIE wysylaj tego pliku nikomu.

APIFY_TOKEN=apify_api_tu_wklej_swoj_klucz

# Slug aktora "TikTok Comments Scraper" z Apify Store (uzywa ~ zamiast /).
# Sprawdz dokladny slug na stronie aktora, ktorego wybierzesz.
APIFY_ACTOR=clockworks~tiktok-comments-scraper
